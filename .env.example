# ibcmon environment. Copy to .env and fill in; .env is git-ignored.
# Every value here is a secret or an operator-specific endpoint. Non-secret
# settings live in ibcmon.yaml (see ibcmon.example.yaml); ${VAR} references in
# that file are expanded from this environment.

# --- gno.land ---------------------------------------------------------------
# Your own node's RPC (tm2 JSON-RPC over HTTP). Never a public endpoint for a
# guardian instance.
IBCMON_GNO_RPC_URL=http://127.0.0.1:26657
# A second, independent RPC used only to cross-check block hashes.
IBCMON_GNO_RPC_URL_2=http://127.0.0.1:26667

# --- Ethereum ---------------------------------------------------------------
# Execution-layer JSON-RPC: your own node, or a Helios endpoint for
# light-client-verified reads (docs/design.md §3.5).
IBCMON_ETH_RPC_URL=http://127.0.0.1:8545
# A second provider, used only to cross-check the finalized block hash.
IBCMON_ETH_RPC_URL_2=
# Beacon API of your own consensus node (finality). Leave empty with
# eth.finality "tag" or "depth:N" (local anvil has no beacon chain).
IBCMON_BEACON_URL=

# --- Alerting ---------------------------------------------------------------
# Webhook sink target; optional HMAC key for the X-Ibcmon-Signature header.
IBCMON_WEBHOOK_URL=
IBCMON_WEBHOOK_SECRET=

# --- Auto-flagging (off by default; docs/design.md §8.4) --------------------
# Both must be set, and autoflag.enabled must be true in ibcmon.yaml, for the
# monitor to sign containment flags with the watch keys. They never leave the
# monitor process.
IBCMON_GNO_WATCH_MNEMONIC=
IBCMON_ETH_WATCH_PRIVATE_KEY=
